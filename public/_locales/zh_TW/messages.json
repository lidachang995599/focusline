  "step1Title": {
    "message": "開啟任意長頁面"
  },
  "step1Body": {
    "message": "點 FocusLine 圖示，開啟開關，頁面就會圍繞你正在讀的那一行變暗。"
  },
  "step2Title": {
    "message": "把線放到眼睛自然停留的位置"
  },
  "step2Body": {
    "message": "拖曳右側握把，或按 <kbd>Alt</kbd> + <kbd>↑</kbd> / <kbd>↓</kbd>；加 <kbd>Shift</kbd> 調線高。"
  },
  "step3Title": {
    "message": "讓頁面安靜下來"
  },
  "step3Body": {
    "message": "靜心模式會停止動畫；還能一鍵隱藏浮動視窗與側欄。"
