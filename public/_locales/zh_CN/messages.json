  "welcomeLead": {
    "message": "一条可拖动的阅读线，压暗周围内容。为 ADHD 与阅读障碍用户设计——无账号、无追踪、数据不出浏览器。"
  },
  "step1Title": {
    "message": "打开任意长页面"
  },
  "step1Body": {
    "message": "点 FocusLine 图标，打开开关，页面就会围绕你正在读的那一行变暗。"
  },
  "step2Title": {
    "message": "把线放到眼睛自然停留的位置"
  },
  "step2Body": {
    "message": "拖动右侧手柄，或按 <kbd>Alt</kbd> + <kbd>↑</kbd> / <kbd>↓</kbd>；加 <kbd>Shift</kbd> 调线高。"
  },
  "step3Title": {
    "message": "让页面安静下来"
  },
  "step3Body": {
    "message": "静心模式会停掉动画；还可以一键隐藏浮窗和侧栏。"
  },
  "calloutTitle": {
    "message": "设置跟着站点走"
  },
  "calloutBody": {
    "message": "每个网站都会记住自己的线高、暗度和已隐藏元素。"
